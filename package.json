{
    "name": "akwaba-web",
    "private": true,
    "version": "1.0.0",
    "description": "Akwaba: Building creative, intelligent applications",
    "scripts": {
        "start": "webpack serve --mode=development --config webpack.dev.js",
        "build": "webpack --mode=production --config webpack.prod.js",
        "typecheck": "tsc --noEmit",
        "postinstall": "patch-package"
    },
    "keywords": [
        "Akwaba",
        "Akwaba Systems",
        "Kawaii",
        "Akwaba Virtual School",
        "Coregenix"
    ],
    "dependencies": {
        "@akwaba/graphene": "2.0.4",
        "react": "18.3.0",
        "react-dom": "18.3.0",
        "react-router-dom": "6.26.0"
    },
    "devDependencies": {
        "@types/react": "18.3.3",
        "@types/react-dom": "18.3.0",
        "classnames": "2.5.1",
        "css-loader": "7.1.3",
        "file-loader": "6.2.0",
        "html-webpack-plugin": "5.6.0",
        "mini-css-extract-plugin": "2.10.0",
        "patch-package": "^8.0.1",
        "prop-types": "15.8.1",
        "sass": "1.97.3",
        "sass-loader": "16.0.6",
        "style-loader": "4.0.0",
        "ts-loader": "9.5.1",
        "typescript": "5.5.4",
        "webpack": "5.94.0",
        "webpack-browser-plugin": "1.0.20",
        "webpack-cli": "5.1.4",
        "webpack-dev-server": "5.0.4",
        "webpack-merge": "5.10.0",
        "webpack-sources": "3.3.3"
    },
    "author": {
        "name": "Daniel Ziaoure",
        "email": "daniel@akwabasystems.com"
    }
}